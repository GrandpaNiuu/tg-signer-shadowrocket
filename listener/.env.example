# Public Worker origin. Do not add a trailing slash.
WORKER_URL=https://your-worker.example.workers.dev

# Generate one random value with at least 32 characters.
# Store the same value as the Worker Secret LISTENER_API_TOKEN.
LISTENER_API_TOKEN=replace-with-a-long-random-secret

LISTENER_INSTANCE_ID=listener-vps-1
LISTENER_LABEL=Telegram Listener VPS
LISTENER_SYNC_SECONDS=30
LISTENER_HEARTBEAT_SECONDS=60
LISTENER_INSPECTION_SECONDS=4
LOG_LEVEL=INFO
