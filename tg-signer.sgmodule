#!name=TG Signer Shadowrocket
#!desc=触发 Cloudflare Worker，再由 Worker 触发 GitHub Actions 运行 tg-signer。Shadowrocket 只负责触发，不保存 Telegram 登录信息。
#!arguments=启用定时触发:false,定时表达式:0 8 * * *,云端接口:https://example.workers.dev/run,触发密钥:change-me,模式:send-text,目标聊天:,签到文本:/checkin,任务名:
#!arguments-desc=云端接口填写 Cloudflare Worker 的 /run 地址。模式可选 send-text 或 task。send-text 使用目标聊天和签到文本；task 使用任务名。定时表达式为 cron 格式。

[Script]
TG签到-手动触发 = type=http-request, pattern=^http:\/\/tg-signer\.local\/run, script-path=https://raw.githubusercontent.com/GrandpaNiuu/tg-signer-shadowrocket/main/shadowrocket/trigger.js, requires-body=0, timeout=60, argument=endpoint={{{云端接口}}}&key={{{触发密钥}}}&mode={{{模式}}}&target_chat={{{目标聊天}}}&checkin_text={{{签到文本}}}&task_name={{{任务名}}}
TG签到-定时触发 = type=cron, cronexpr={{{定时表达式}}}, script-path=https://raw.githubusercontent.com/GrandpaNiuu/tg-signer-shadowrocket/main/shadowrocket/trigger.js, timeout=60, argument=endpoint={{{云端接口}}}&key={{{触发密钥}}}&mode={{{模式}}}&target_chat={{{目标聊天}}}&checkin_text={{{签到文本}}}&task_name={{{任务名}}}, enable={{{启用定时触发}}}

[MITM]
hostname = tg-signer.local
