# Reference only. Never commit a populated copy of this file.
# After migration, accounts and tasks are managed in the web admin rather than here.

# GitHub repository variables used by the D1-backed Runner
WORKER_URL=https://tg-signer-shadowrocket.example.workers.dev
WORKER_OIDC_AUDIENCE=https://tg-signer-shadowrocket.example.workers.dev/api/runner

# Cloudflare Worker secrets (set with Cloudflare; never store in D1 or the repository)
GITHUB_TOKEN=
# Base64 of exactly 32 random bytes
SECRET_ROOT_KEY=
# GitHub OAuth App credentials for GitHub login and automatic registration
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Public email authentication (all values are deployment infrastructure, not daily task configuration)
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# At least 16 random characters; changing it invalidates existing password hashes
PASSWORD_PEPPER=

# Cloudflare Worker variables / single-administrator configuration
ADMIN_ORIGIN=https://telegram-checkin-admin.pages.dev
ADMIN_GITHUB_LOGIN=GrandpaNiuu
ADMIN_GITHUB_USER_ID=225517310
ADMIN_SESSION_TTL_SECONDS=604800
SECRET_KEY_VERSION=1
TURNSTILE_SITE_KEY=
AUTH_EMAIL_FROM=Telegram Check-in <login@example.com>
PASSWORD_HASH_ITERATIONS=600000

# Cloudflare Pages production variable
CANONICAL_HOST=telegram-checkin-admin.pages.dev

# GitHub deployment secrets
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Telegram accounts, Sessions, proxies, destinations, message text and
# notifications are configured in the web admin and encrypted in D1.
