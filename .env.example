# Reference only. Never commit a populated copy of this file.
# After migration, accounts and tasks are managed in the web admin rather than here.

# GitHub repository variables used by the D1-backed Runner
WORKER_URL=https://tg-signer-shadowrocket.example.workers.dev
WORKER_OIDC_AUDIENCE=https://tg-signer-shadowrocket.example.workers.dev/api/runner

# Cloudflare Worker secrets (set with Cloudflare; never store in D1 or the repository)
GITHUB_TOKEN=
TRIGGER_KEY=
# Base64 of exactly 32 random bytes
SECRET_ROOT_KEY=

# Cloudflare Worker variables / Access configuration
ADMIN_EMAIL=admin@example.com
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=
SECRET_KEY_VERSION=1

# Cloudflare Pages production variable
REQUIRE_ACCESS_HEADER=true
CANONICAL_HOST=grandpaniu.ccwu.cc

# GitHub deployment secrets
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Legacy primary account — retained for zero-downtime migration and rollback
TG_SESSION_STRING=
TG_TARGET_CHAT=@checkin_bot
TG_CHECKIN_TEXT=/checkin
TG_MESSAGE_THREAD_ID=
TG_SIGNER_TASK_NAME=
TG_SIGNER_IMPORT_BASE64=
TG_ACCOUNT=
TG_PROXY=
CHECKIN_DELETE_AFTER=

# Optional legacy second account
TG_SESSION_STRING_2=
TG_TARGET_CHAT_2=
TG_CHECKIN_TEXT_2=
TG_MESSAGE_THREAD_ID_2=
TG_SIGNER_TASK_NAME_2=
TG_SIGNER_IMPORT_BASE64_2=
TG_ACCOUNT_2=
TG_PROXY_2=
CHECKIN_DELETE_AFTER_2=

# Optional legacy notification adapter
TELEGRAM_NOTIFY_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=
